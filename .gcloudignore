# Ignore local git directory
.git/
.gitignore

# Ignore local Python virtual environments and sensitive credentials
venv/
.env

# Ignore compiled Python files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore local unit tests and test configs
test_main.py
test_multitenant.py

# Ignore local sqlite DB and image logs
api_logs.db
logs/
logs*.txt
